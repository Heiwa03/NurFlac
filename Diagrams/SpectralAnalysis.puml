@startuml Spectral Analysis Patterns

skinparam monochrome false
skinparam packageStyle rectangle

package "AudioProcessing.SpectralAnalysis (NEW)" {
    
    interface IScanConfigPrototype {
        + Clone() : IScanConfigPrototype
    }

    class ScanConfig <<PROTOTYPE>> {
        + FftSize : int
        + ThresholdDb : double
        + LosslessCutoffHz : double
        + SampleDurationSeconds : int
        + Clone() : IScanConfigPrototype
    }

    class ScanConfigBuilder <<BUILDER>> {
        - _config : ScanConfig
        + WithHighResolution() : ScanConfigBuilder
        + WithThreshold(db: double) : ScanConfigBuilder
        + WithCutoff(hz: double) : ScanConfigBuilder
        + Build() : ScanConfig
    }

    class SpectralAnalysisResult <<DTO>> {
        + IsTrueLossless : bool
        + DetectedCutoffHz : double
        + RequiredCutoffHz : double
        + ThresholdDb : double
    }

    interface ISpectralAnalysisEngine {
        + AnalyzeAsync(samples, sampleRate, config) : Task<SpectralAnalysisResult>
    }

    class SpectralAnalysisEngine <<SINGLETON>> {
        - {static} _instance : SpectralAnalysisEngine
        + {static} Instance : SpectralAnalysisEngine
        + AnalyzeAsync() : Task<SpectralAnalysisResult>
    }

    IScanConfigPrototype <|.. ScanConfig
    ISpectralAnalysisEngine <|.. SpectralAnalysisEngine
}

package "AudioProcessing.Analyzers (EXISTING)" {
    abstract class BaseSpectralAnalyzer <<TEMPLATE METHOD>> {
        # ScanConfig : ScanConfig
        + AnalyzeTrueLosslessAsync(filePath) : Task<SpectralAnalysisResult>
    }
}

ScanConfigBuilder --> ScanConfig : constructs
BaseSpectralAnalyzer --> ScanConfig : uses
BaseSpectralAnalyzer ..> SpectralAnalysisEngine : delegates to
SpectralAnalysisEngine ..> SpectralAnalysisResult : produces

@enduml
