@startuml Repository

title Repository Pattern — Persistence Abstraction

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

' ── Repository interfaces ──────────────────────────────────────
interface IDuplicateFingerprintRepository <<interface>> {
  + ExistsAsync(fingerprint : string, cancellationToken : CancellationToken) : Task<bool>
  + AddUploadedEntryAsync(fingerprint : string, fileName : string, providerName : string, uploadedByTelegramId : long, cancellationToken : CancellationToken) : Task
}

interface ICommandExecutionTracker <<interface>> {
  + TrackAsync(commandKey : string, telegramId : long, outcome : CommandExecutionOutcome, durationMs : long, error : string, cancellationToken : CancellationToken) : Task
}

' ── Concrete Repositories ──────────────────────────────────────
class SqliteDuplicateFingerprintRepository {
  - _connectionString : string
  - _initLock : SemaphoreSlim
  - _initialized : bool
  + SqliteDuplicateFingerprintRepository(dbPath : string)
  + ExistsAsync(fingerprint : string, cancellationToken : CancellationToken) : Task<bool>
  + AddUploadedEntryAsync(fingerprint : string, fileName : string, providerName : string, uploadedByTelegramId : long, cancellationToken : CancellationToken) : Task
  - EnsureInitializedAsync(cancellationToken : CancellationToken) : Task
}

class SqliteCommandExecutionTracker {
  - _connectionString : string
  - _initLock : SemaphoreSlim
  - _initialized : bool
  + SqliteCommandExecutionTracker(dbPath : string)
  + TrackAsync(commandKey : string, telegramId : long, outcome : CommandExecutionOutcome, durationMs : long, error : string, cancellationToken : CancellationToken) : Task
  - EnsureInitializedAsync(cancellationToken : CancellationToken) : Task
}

' ── Clients ────────────────────────────────────────────────────
class DuplicateCheckFacade {
  - _repository : IDuplicateFingerprintRepository
}

class CommandRouter {
  - _tracker : ICommandExecutionTracker
}

' ── Enumerations ───────────────────────────────────────────────
enum CommandExecutionOutcome <<enumeration>> {
  Success
  UnknownCommand
  Failed
}

' Realizations
SqliteDuplicateFingerprintRepository ..|> IDuplicateFingerprintRepository : realizes
SqliteCommandExecutionTracker ..|> ICommandExecutionTracker : realizes

' Client dependencies (depend on abstractions, not concretions)
DuplicateCheckFacade --> IDuplicateFingerprintRepository : _repository
CommandRouter --> ICommandExecutionTracker : _tracker

SqliteCommandExecutionTracker ..> CommandExecutionOutcome : uses

note top of IDuplicateFingerprintRepository
  Repository
  Abstracts all SQLite access for
  uploaded audio fingerprints.
  Clients depend only on the interface.
end note

note top of ICommandExecutionTracker
  Repository
  Abstracts all SQLite access for
  command execution audit log.
  Clients depend only on the interface.
end note

note right of SqliteDuplicateFingerprintRepository
  Concrete Repository
  SQLite-backed; uses SemaphoreSlim
  double-check pattern for lazy
  schema initialization
end note

footer Repository · Domain-Driven Design · NurFlac

@enduml
