@startuml Memento

title Memento Pattern — Multi-Stage Upload Recovery

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

' ── Memento ───────────────────────────────────────────────────
class UploadSessionMemento <<record>> {
  + SessionId : string
  + TelegramId : long
  + ChatId : long
  + FileId : string
  + FileName : string
  + LocalFilePath : string?
  + Status : UploadStatus
  + CreatedAt : DateTime
}

enum UploadStatus {
  Started
  Downloaded
  Validated
  Completed
  Failed
}

' ── Originator ────────────────────────────────────────────────
class SingleAudioUploadCommand {
  - _caretaker : IUploadSessionCaretaker
  + ExecuteAsync(message : Message, user : User) : Task
  + ResumeSessionAsync(memento : UploadSessionMemento) : Task
  - ProcessUploadAsync(memento : UploadSessionMemento, ...) : Task
}

' ── Caretaker ─────────────────────────────────────────────────
interface IUploadSessionCaretaker <<interface>> {
  + SaveMementoAsync(memento : UploadSessionMemento) : Task
  + GetPendingSessionsAsync() : Task<IEnumerable<UploadSessionMemento>>
  + RemoveMementoAsync(sessionId : string) : Task
}

class SqliteUploadSessionCaretaker {
  - _connectionString : string
  + SaveMementoAsync(...) : Task
  + GetPendingSessionsAsync(...) : Task
  + RemoveMementoAsync(...) : Task
}

' ── Client (Recovery Trigger) ─────────────────────────────────
class TelegramBotWorker {
  - _caretaker : IUploadSessionCaretaker
  - _uploadCommand : SingleAudioUploadCommand
  # ExecuteAsync(stoppingToken : CancellationToken) : Task
}

' Relationships
UploadSessionMemento +-- UploadStatus

' Originator creates and consumes Mementos
SingleAudioUploadCommand ..> UploadSessionMemento : «creates/consumes»

' Caretaker manages Mementos
SqliteUploadSessionCaretaker ..|> IUploadSessionCaretaker : realizes
IUploadSessionCaretaker --> "0..*" UploadSessionMemento : manages

' Originator uses Caretaker to persist its state
SingleAudioUploadCommand --> IUploadSessionCaretaker : _caretaker

' Recovery trigger uses Caretaker to find lost Mementos
TelegramBotWorker --> IUploadSessionCaretaker : _caretaker
TelegramBotWorker --> SingleAudioUploadCommand : _uploadCommand

note right of SingleAudioUploadCommand
  **Originator**
  Can capture its current 
  upload state into a Memento 
  and restore its state 
  from one.
end note

note bottom of UploadSessionMemento
  **Memento**
  Internal state of the 
  upload process.
  Stored externally but 
  opaque to other objects.
end note

note bottom of SqliteUploadSessionCaretaker
  **Caretaker**
  Responsible for the 
  Memento's safe keeping.
  Never operates on or 
  examines the contents 
  of the Memento.
end note

footer Memento · GoF Behavioral · NurFlac

@enduml
