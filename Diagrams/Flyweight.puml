@startuml Flyweight

title Flyweight Pattern — AudioFormat

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

' ── Flyweight ──────────────────────────────────────────────────
class AudioFormat {
  + Id : string
  + DisplayName : string
  + Extensions : IReadOnlyList<string>
  + MimeTypes : IReadOnlyList<string>
  + IsLossless : bool
  ~~ AudioFormat(id, displayName, extensions, mimeTypes, isLossless)
}

note right of AudioFormat
  **Intrinsic state** (shared, immutable):
  format name, extensions, MIME types,
  lossless flag.
  One instance per format;
  never duplicated across requests.
end note

' ── Flyweight Factory ──────────────────────────────────────────
class AudioFormatRegistry {
  - _byExtension : IReadOnlyDictionary<string, AudioFormat>
  - _byMimeType : IReadOnlyDictionary<string, AudioFormat>
  - _all : IReadOnlyList<AudioFormat>
  + AudioFormatRegistry()
  + GetByExtension(extension : string) : AudioFormat?
  + GetByMimeType(mimeType : string) : AudioFormat?
  + GetAll() : IReadOnlyList<AudioFormat>
  + GetAllLossless() : IReadOnlyList<AudioFormat>
}

note left of AudioFormatRegistry
  **Flyweight Factory**
  Pre-populates pool on construction.
  Returns shared instances; never
  creates duplicates for the same format.
end note

' ── Extrinsic state carrier ────────────────────────────────────
class AudioFileContext {
  + FileName : string
  + Extension : string
  + MimeType : string?
  + TelegramFileId : string
  + LocalFilePath : string?
}

note bottom of AudioFileContext
  **Extrinsic state** (per-request, not shared):
  the specific file being validated.
  Passed in at runtime; never stored
  inside the flyweight.
end note

' ── Clients (use factory to get flyweights) ────────────────────
class ExtensionValidatorDecorator {
  - _registry : AudioFormatRegistry
  + ValidateAsync(context : AudioFileContext, ...) : Task<ValidationResult>
}

class MimeValidatorDecorator {
  - _registry : AudioFormatRegistry
  + ValidateAsync(context : AudioFileContext, ...) : Task<ValidationResult>
}

class OrganizedAudioLibraryStorage {
  - _registry : AudioFormatRegistry
  + UploadAudioAsync(context : AudioFileContext, ...) : Task<bool>
}

' Relationships
AudioFormatRegistry *--> "1..* (pool)" AudioFormat : maintains flyweight pool

ExtensionValidatorDecorator --> AudioFormatRegistry : GetByExtension()
MimeValidatorDecorator --> AudioFormatRegistry : GetByMimeType()
OrganizedAudioLibraryStorage --> AudioFormatRegistry : GetByExtension()

ExtensionValidatorDecorator ..> AudioFileContext : reads extrinsic state
MimeValidatorDecorator ..> AudioFileContext : reads extrinsic state

footer Flyweight · GoF Structural · NurFlac

@enduml
