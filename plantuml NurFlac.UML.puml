' =============================================================================
' Package 1 - Entry Point & Routing
' =============================================================================
package "1. Entry Point & Routing" {
    class Program << (S,#FF7700) static >> {
        +Main(args: string[]): void
    }

    interface ITelegramBotClient << external >>

    class TelegramBotWorker {
        - _botClient: ITelegramBotClient
        - _updateHandler: UpdateHandler
        - _logger: ILogger<TelegramBotWorker>
        + ExecuteAsync(stoppingToken: CancellationToken): Task
    }

    class UpdateHandler {
        - _commandRouter: CommandRouter
        - _logger: ILogger<UpdateHandler>
        + HandleUpdateAsync(botClient: ITelegramBotClient, update: Update, ct: CancellationToken): Task
    }

    class CommandRouter {
        - _commands: Dictionary<string, ICommand>
        - _logger: ILogger<CommandRouter>
        + RouteMessageAsync(message: Message): Task
    }
}

